<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property
        name="CONSOLE_LOG_PATTERN"
        value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p ${PID:- } --- [%15.15t] [req:%X{requestId:-}] %X{endpoint:-} [user:%X{userId:-}/%X{externalUserId:-}] %-40.40logger{39} : %m%n%wEx"
    />

    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 클라이언트 조기 연결 종료(broken pipe, connection reset)는 서버가 조치할 수 없는 정상 상황이다.
         Spring이 이 목적으로 분리해 둔 카테고리를 OFF로 내려 노이즈를 제거한다. -->
    <logger name="org.springframework.web.servlet.handler.DisconnectedClient" level="OFF"/>
    <logger name="org.springframework.web.servlet.mvc.method.annotation.DisconnectedClient" level="OFF"/>

    <springProfile name="prod">
        <logger name="org.prography" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
        <logger name="org.springframework.web.servlet.PageNotFound" level="WARN"/>
    </springProfile>

    <springProfile name="!prod">
        <logger name="org.prography" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>